# Copy to .env for local development. Every variable the backend reads is here;
# unset optional ones keep the feature off.

# --- server
PORT=3000
NODE_ENV=development
# true = local Postgres via PG*; false = RDS (IAM auth via RDS_*) or DATABASE_URL
IS_OFFLINE=true
# Runs the sweep (scheduled rules, deadlines, calendar + integration syncs). One instance only.
ENABLE_SCHEDULER=true
SCHEDULER_INTERVAL_SECONDS=30
LOG_LEVEL=info
# json in production by default; text for humans
LOG_FORMAT=text
TRUST_PROXY_HOPS=1
APP_VERSION=dev

# --- auth (required): any long random strings, different from each other
JWT_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# --- database
PGHOST=localhost
PGPORT=5432
PGDATABASE=jiko
PGUSER=postgres
PGPASSWORD=postgres
# A managed Postgres hands you one URL; it wins over PG*.
# DATABASE_URL=postgres://user:pass@host:5432/jiko
# PG_POOL_MAX=10
# PGSSL_NO_VERIFY=false

# --- connected accounts (Google, Canvas). See docs/integrations.md.
# Seals stored OAuth/Canvas tokens. 32 bytes: `openssl rand -hex 32`. Without it,
# nothing can be connected. Keep it out of backups; losing it means everyone reconnects.
JIKO_TOKEN_KEY=
# The public https origin users reach, e.g. https://64-181-196-147.sslip.io.
# Google redirects to $JIKO_PUBLIC_URL/integrations/google/callback.
JIKO_PUBLIC_URL=http://localhost:3000
# From Google Cloud console -> APIs & Services -> Credentials -> OAuth client (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# JIKO_INTEGRATION_WINDOW_DAYS=30
# JIKO_INTEGRATION_TIMEOUT_MS=15000

# --- calendar feeds (ICS)
# JIKO_ICS_ALLOW_HTTP=false
# JIKO_ICS_ALLOW_PRIVATE=false
# JIKO_ICS_MAX_BYTES=5242880
# JIKO_ICS_TIMEOUT_MS=15000

# --- Claude voice (optional): nudges rewritten in the user's chosen voice
# ANTHROPIC_API_KEY=
# JIKO_LLM_MODEL=claude-opus-5

# --- delivery
# JIKO_WEBHOOK_URL=
# JIKO_WEBHOOK_SECRET=
# SMS (AWS End User Messaging): inbound webhook shared secret
# JIKO_SMS_WEBHOOK_SECRET=
# JIKO_SMS_AUTO_CONFIRM=false
# AWS_REGION=us-east-1

# --- tuning (defaults are fine)
# JIKO_ADAPTIVE_BUDGET=true
# JIKO_BUDGET_WINDOW_DAYS=7
# JIKO_WRONG_LIMIT=3
# JIKO_WRONG_WINDOW_DAYS=7
# JIKO_TIRED_SLEEP_MINUTES=300
# JIKO_SWEEP_LOCK_KEY=8675309
# JIKO_RATE_LIMIT=true
# JIKO_RATE_LIMIT_AUTH= JIKO_RATE_LIMIT_SYNC= JIKO_RATE_LIMIT_MESSAGES= JIKO_RATE_LIMIT_GLOBAL=
# JIKO_BODY_LIMIT=128kb
# JIKO_SYNC_BODY_LIMIT=2mb

# --- RDS (only when IS_OFFLINE=false and no DATABASE_URL)
# RDS_HOST= RDS_PORT=5432 RDS_USER= RDS_DB_NAME=
