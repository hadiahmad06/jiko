{
  "name": "jiko-backend",
  "version": "1.0.0",
  "description": "Jiko backend: sync ingestion, trigger engine, and API",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch 'src/**/*.ts' --exec \"tsx src/index.ts\"",
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "pretest": "npm run typecheck",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:watch": "vitest watch --project unit",
    "localdb": "tsx scripts/localdb.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "routes": "tsx scripts/printRoutes.ts"
  },
  "author": "Hadi Ahmad",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@aws-sdk/client-dynamodb": "^3.914.0",
    "@aws-sdk/client-sns": "^3.915.0",
    "@aws-sdk/lib-dynamodb": "^3.914.0",
    "@aws-sdk/rds-signer": "^3.922.0",
    "@types/express": "^5.0.3",
    "bcrypt": "^6.0.0",
    "dockerode": "^4.0.9",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.2",
    "ngeohash": "^0.6.3",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/dockerode": "^3.3.45",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ngeohash": "^0.6.8",
    "@types/node": "^24.9.1",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^11.0.0",
    "eslint": "^10.10.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.0.8"
  }
}
